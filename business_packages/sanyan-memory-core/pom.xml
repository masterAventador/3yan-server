<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sanyan</groupId>
        <artifactId>sanyan-server-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>sanyan-memory-core</artifactId>
    <name>sanyan-memory-core</name>
    <packaging>jar</packaging>

    <!--
        Plan 2 Task L0：模块空壳，仅注册到父 pom。
        后续 Task N1-Q4 会填充 summary / profile / rag / orchestrator 子包。
        注意：sanyan-memory-core 需要依赖 sanyan-business（订阅 MessagePersistedEvent + 调 LLM router），
        这是 Plan 1 未拆 chat -api/-core 的妥协，Plan 3 会修复。该例外的 Enforcer 允许放行写在本 pom 里。

        Task N0：补 junit-jupiter + assertj-core 用于 MemoryConstants 对齐铁律测试。
        Task N1：补 spring-boot-starter-data-jpa（Entity + Repository）+ Postgres driver + sanyan-common-test（Testcontainers PG）。
        Task N2：补 sanyan-business（compile scope）——MemorySummaryService 需要
                 引用 chat 域的 MessageEntity/SenderType + PromptBuilder。理由同上：
                 Plan 1 没把 chat 拆 -api/-core，所以现阶段只能整包依赖；Plan 3 拆完后改成
                 只依赖 sanyan-chat-api（拿到 MessageDto + LLM 路由契约）。

        S3 Phase 3：LLM 路由从 sanyan-business 拆到 sanyan-llm-core，跨模块改走
                    sanyan-llm-api 契约（LlmApi 接口 + LlmTaskType + ChatMessage），不再持有
                    LLMProviderRouter。摘要 / profile 刷新两条链路都换成 LlmApi.chat。

        Task O4：补 sanyan-common-cache —— UserMessageProfileExtractListener 用 KvCache.setIfAbsent
                 做 5 分钟节流（同一 user/character 5 分钟内最多触发一次档案抽取）。
                 不直接用 RedisTemplate，遵守 foundation-layer 规则（业务代码统一走 KvCache 封装）。

        Task P1：补 com.pgvector:pgvector （pgvector-java SDK，0.1.6 是 Maven Central 当前最新稳定版，
                 plan spec 写的 0.1.7 暂未发布）—— 提供 PGvector 包装类用于 JDBC 与 PG vector 类型互转。
                 ChatEmbeddingEntity 的 embedding float[] 字段通过 PgVectorType（Hibernate 6 UserType）
                 走 PGvector 序列化。

        Task P4：补 sanyan-memory-api —— MemoryRagSearchService.search 返回 List<MemoryFragment>，
                 MemoryFragment record 是跨模块 DTO 契约，定义在 sanyan-memory-api/dto。
    -->
    <dependencies>
        <!--
            P4：跨模块 DTO（MemoryFragment）契约 + Q2 阶段的 MemoryApi 接口都定义在 sanyan-memory-api。
            -core 实现侧依赖 -api 是 java-backend rule 默认允许的方向（业务的 -core → 同业务的 -api）。
        -->
        <dependency>
            <groupId>com.sanyan</groupId>
            <artifactId>sanyan-memory-api</artifactId>
        </dependency>
        <!--
            S3 Phase 5：删除 Plan 2 时代的 sanyan-business 整包妥协依赖。

            历史：Plan 2 时代 chat 域还在 sanyan-business 里，memory-core 需要访问
            MessageEntity / MessageRepository / SenderType / PromptBuilder，只能整包依赖
            sanyan-business（已在 enforcer 例外里登记）。

            S3 Phase 5 拆出 sanyan-chat-api + sanyan-chat-core 后：
            - memory-core 通过 sanyan-chat-api (ChatApi 契约 + MessageDto + SenderType + MessagePersistedEvent) 拿数据
            - 不再需要看 chat 域的 internal 任何东西
            - 不再需要看 sanyan-business 内的 PromptBuilder（memory-core 自己内联拼装 ChatMessage）

            至此 Plan 2 妥协彻底结束，java-backend §3.3「跨模块不引 internal」铁律重新生效。
        -->
        <dependency>
            <groupId>com.sanyan</groupId>
            <artifactId>sanyan-chat-api</artifactId>
        </dependency>

        <!--
            S3 Phase 3：MemorySummaryService + MemoryProfileRefreshService 跨模块调 LLM
            走 LlmApi 契约（不再直接持有 LLMProviderRouter）。
        -->
        <dependency>
            <groupId>com.sanyan</groupId>
            <artifactId>sanyan-llm-api</artifactId>
        </dependency>

        <!--
            S3 Phase 4：MemoryRagSearchService + MemoryEmbeddingService 跨模块调 embedding
            走 EmbeddingApi 契约（取代 Plan 2 时代的 EmbeddingProvider，后者已删）。
        -->
        <dependency>
            <groupId>com.sanyan</groupId>
            <artifactId>sanyan-embedding-api</artifactId>
        </dependency>

        <!-- O4：Redis 节流走 common-cache 的 KvCache（不直接碰 RedisTemplate） -->
        <dependency>
            <groupId>com.sanyan</groupId>
            <artifactId>sanyan-common-cache</artifactId>
        </dependency>

        <!--
            S3 Phase 5：删 sanyan-business 整包依赖后，这些原本经 business 传递的依赖必须直接声明：
            - common-error：MemoryErrCode / BusinessException / ErrCode
            - jackson-databind：MessageEmbeddingIndexListener / RagIndexWorker 序列化 ChunkIndexJob
        -->
        <dependency>
            <groupId>com.sanyan</groupId>
            <artifactId>sanyan-common-error</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 主代码：JPA Entity + Repository -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
            P1：pgvector Java SDK，提供 PGvector 包装类 + JDBC 类型互转。
            ChatEmbeddingEntity.embedding (float[]) 通过 PgVectorType（Hibernate UserType）
            序列化为 PG vector(1024)。最新稳定版 0.1.6（Maven Central 截至当前），
            plan spec 写的 0.1.7 暂未发布。
        -->
        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>0.1.6</version>
        </dependency>
        <!-- Entity 用 @Data / @NoArgsConstructor / @AllArgsConstructor 减少样板 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- 测试基础 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Postgres JDBC driver。
            P1 之前是 test scope（仅 Testcontainers 用），P1 起改为 compile scope：
            pgvector-java 的 PGvector 类继承 org.postgresql.util.PGobject，
            PgVectorType 编译时需要这些符号。
            生产 datasource 也是 PG，编译期就引入并无额外风险。
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- 共享 Testcontainer PG 基类 + TestApplication（@SpringBootConfiguration 上下文根） -->
        <dependency>
            <groupId>com.sanyan</groupId>
            <artifactId>sanyan-common-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            S3 Phase 6：sanyan-business 模块彻底删除。Flyway V*.sql 主副本已迁到
            bootstrap/src/main/resources/db/migration/（生产 schema 归属 bootstrap）。
            本模块 RAG IT（ChatEmbeddingRepositoryIT / MemoryRagSearchServiceIT）通过
            spring.flyway.locations=classpath:db/migration 找 SQL，所以在
            src/test/resources/db/migration/ 留一份**测试副本**——
            副本而非引用，保持 memory-core 测试与其它模块资源完全解耦。
            副本同步规则：生产 V*.sql 改动时，需要手动同步到本模块 test resources。
        -->
    </dependencies>

    <build>
        <plugins>
            <!-- Testcontainers 配置（api.version + RYUK_DISABLED）由父 pom pluginManagement 统一提供 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
