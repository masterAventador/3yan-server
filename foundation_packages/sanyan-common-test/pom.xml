<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sanyan</groupId>
        <artifactId>sanyan-server-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>sanyan-common-test</artifactId>

    <dependencies>
        <!-- 显式覆盖父 POM dependencyManagement 里的 test scope，
             让本模块在 compile scope 暴露 archunit，
             下游模块以 test scope 引入 sanyan-common-test 时 archunit 才能传递可见 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>

        <!-- Testcontainers：用 compile scope 暴露给下游 test 模块，
             让 PostgresTestcontainerSupport 在 bootstrap / *-core 的测试里可见 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>compile</scope>
        </dependency>
        <!-- Postgres JDBC + Flyway PG dialect 也以 compile scope 暴露给下游 test 用 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- MockWebServer：用 compile scope 暴露给下游 test 模块，
             让 HTTP 客户端测试可以 mock 上游服务（如 DeepSeek、embedding-server） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- foundation 模块禁止反向依赖 business -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-no-business-dep</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- 历史：sanyan-business 单体（已 S3 Phase 6 删除）-->
                                        <exclude>com.sanyan:sanyan-business</exclude>
                                        <!-- S3 拆模块后 6 对 -api/-core 全部不允许 foundation 反向依赖 -->
                                        <exclude>com.sanyan:sanyan-user-api</exclude>
                                        <exclude>com.sanyan:sanyan-user-core</exclude>
                                        <exclude>com.sanyan:sanyan-character-api</exclude>
                                        <exclude>com.sanyan:sanyan-character-core</exclude>
                                        <exclude>com.sanyan:sanyan-chat-api</exclude>
                                        <exclude>com.sanyan:sanyan-chat-core</exclude>
                                        <exclude>com.sanyan:sanyan-llm-api</exclude>
                                        <exclude>com.sanyan:sanyan-llm-core</exclude>
                                        <exclude>com.sanyan:sanyan-embedding-api</exclude>
                                        <exclude>com.sanyan:sanyan-embedding-core</exclude>
                                        <exclude>com.sanyan:sanyan-memory-api</exclude>
                                        <exclude>com.sanyan:sanyan-memory-core</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
