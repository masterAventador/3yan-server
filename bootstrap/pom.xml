<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sanyan</groupId>
        <artifactId>sanyan-server-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bootstrap</artifactId>
    <name>sanyan-server-bootstrap</name>

    <dependencies>
        <dependency><groupId>com.sanyan</groupId><artifactId>sanyan-business</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.sanyan</groupId><artifactId>sanyan-common-test</artifactId><scope>test</scope></dependency>
        <!--
            sanyan-memory-core compile scope：MemoryApiImpl (Q2) 是 MemoryApi 的唯一实现，
            AiService (Q4) 通过 @Autowired MemoryApi 注入，生产 fat jar 必须包含 memory-core
            才能完成 DI 装配。L0/L1 Enforcer 规则只限制 embedding-core 不能进 bootstrap，
            没有禁止 memory-core，所以 compile scope 合规。
        -->
        <dependency><groupId>com.sanyan</groupId><artifactId>sanyan-memory-core</artifactId></dependency>
    </dependencies>

    <build>
        <finalName>sanyan-server-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
            </plugin>

            <!--
                Testcontainers 在 surefire 派生 JVM 里的两块配置：
                  1. systemPropertyVariables.api.version=1.44：docker-java 3.4.x 客户端默认
                     声明 API 版本 1.32，与 Docker Engine 25+ 最小要求 1.44 不兼容；docker-java
                     通过系统属性 {@code api.version} 读取目标版本（**不是** {@code DOCKER_API_VERSION}
                     环境变量，env 在 3.4.x 上不生效，亲测 L2 验证）。
                  2. environmentVariables.TESTCONTAINERS_RYUK_DISABLED=true：开发机若用 Colima
                     等 rootless Docker，Ryuk 清理容器无法绑定 host 上的 docker.sock；本地禁用
                     Ryuk，依赖 JVM 退出时 GenericContainer.stop() 自己清理。CI / Linux Docker
                     上可通过 CLI 覆盖打开。
                DOCKER_HOST 通过开发机的 ~/.testcontainers.properties 或 shell env 配置。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>
            <!--
                R1 task：failsafe 派生 JVM 需要与 surefire 同样的 docker-java api.version + Ryuk 禁用
                环境，否则 *IT 跑 Testcontainers PG 时报 "Could not find a valid Docker environment"。
                父 pom 的 pluginManagement 只定义了 failsafe 的 includes / executions 绑定，没含
                Testcontainers 配置；各 IT-using 子模块（如 sanyan-memory-core）都自己在 failsafe
                上显式补这两块配置。bootstrap 一直缺这块，R1 写第一个 IT 时暴露并补齐。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>

        </plugins>
    </build>
</project>
