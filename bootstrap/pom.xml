<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sanyan</groupId>
        <artifactId>sanyan-server-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bootstrap</artifactId>
    <name>sanyan-server-bootstrap</name>

    <dependencies>
        <dependency><groupId>com.sanyan</groupId><artifactId>sanyan-business</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.sanyan</groupId><artifactId>sanyan-common-test</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <finalName>sanyan-server-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
            </plugin>

            <!--
                Testcontainers 在 surefire 派生 JVM 里需要两个环境变量：
                  - DOCKER_API_VERSION=1.44：docker-java 3.4.x 默认请求 API 1.32，与 Docker
                    Engine 25+ 最小 API 版本 1.44 不兼容；显式指定避免 BadRequest。
                  - TESTCONTAINERS_RYUK_DISABLED=true：开发机若用 Colima 等 rootless Docker，
                    Ryuk 清理容器无法绑定 host 上的 docker.sock；本地禁用 Ryuk，依赖 JVM 退出时
                    GenericContainer.stop() 自己清理。CI / Linux Docker 上可通过 CLI 覆盖打开。
                DOCKER_HOST 通过开发机的 ~/.testcontainers.properties 或 shell env 配置。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <DOCKER_API_VERSION>1.44</DOCKER_API_VERSION>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>

            <!--
                Plan 2 Enforcer：主 bootstrap 只能依赖 sanyan-embedding-api（协议契约），
                禁止依赖 sanyan-embedding-core（实现层，那是 embedding-bootstrap 的事）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-bootstrap-no-embedding-core</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.sanyan:sanyan-embedding-core</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
